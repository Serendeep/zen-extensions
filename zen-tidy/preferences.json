[
  { "type": "separator", "label": "Zen Tidy", "id": "zen-tidy-separator" },
  {
    "property": "extensions.zen-tidy.ai",
    "label": "Use Firefox's on-device AI to group and name leftover tabs",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "extensions.zen-tidy.grouping",
    "label": "How eagerly AI groups tabs together",
    "type": "dropdown",
    "placeholder": false,
    "value": "string",
    "defaultValue": "0.75",
    "options": [
      { "value": "0.65", "label": "Strict (more, smaller folders)" },
      { "value": "0.75", "label": "Balanced" },
      { "value": "0.85", "label": "Loose (fewer, bigger folders)" }
    ],
    "conditions": [{ "if": { "property": "extensions.zen-tidy.ai", "value": true } }]
  },
  {
    "property": "extensions.zen-tidy.unsorted",
    "label": "Put leftover tabs in an \"Unsorted\" folder",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "extensions.zen-tidy.rules",
    "label": "Your domain rules, e.g. github.com=Code; linear.app=Work",
    "type": "string",
    "placeholder": "domain=Folder; domain=Folder",
    "defaultValue": ""
  },
  {
    "property": "extensions.zen-tidy.shortcut",
    "label": "Shortcut (needs restart), e.g. Alt+Shift+T",
    "type": "string",
    "defaultValue": "Alt+Shift+T"
  }
]
